---
import SiteLayout from "../layouts/SiteLayout.astro"

const repository = "https://github.com/momobasehq/momobase"
---

<SiteLayout
  title="Momobase — Payment infrastructure you control"
  description="A self-hosted payment orchestration service with one API for the providers you choose."
>
  <main id="main" class="mx-auto flex min-h-[calc(100svh-10rem)] w-full max-w-[1128px] items-center px-6 py-20 max-sm:px-4">
    <section class="max-w-[820px]">
      <p class="font-mono text-[10px] font-medium tracking-[0.12em] text-muted uppercase dark:text-muted-dark">
        Open source · Self-hosted
      </p>

      <h1 class="mt-6 text-[clamp(3.5rem,8vw,7rem)] leading-[0.92] font-medium tracking-[-0.07em]">
        One API.<br />Your payments.
      </h1>

      <p class="mt-8 max-w-[620px] text-[clamp(1rem,1.5vw,1.125rem)] leading-7 text-muted dark:text-muted-dark">
        Connect payment providers without giving up control of your credentials, routing, or transaction data.
      </p>

      <div class="mt-9 flex items-center gap-6 text-sm font-medium">
        <a class="inline-flex min-h-11 items-center bg-text px-5 text-page transition-colors hover:bg-brand dark:bg-text-dark dark:text-page-dark dark:hover:bg-brand-dark" href={`${repository}/blob/main/docs/README.md`}>
          Get started
        </a>
        <a class="hover:text-brand dark:hover:text-brand-dark" href={`${repository}/releases/latest`}>Download ↓</a>
      </div>

      <ul class="mt-16 flex flex-wrap gap-x-8 gap-y-3 border-t border-border pt-5 text-xs text-muted dark:border-border-dark dark:text-muted-dark" aria-label="Project details">
        <li>Provider agnostic</li>
        <li>Single Go binary</li>
        <li>MIT licensed</li>
      </ul>
    </section>
  </main>
</SiteLayout>
