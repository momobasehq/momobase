---
const repository = "https://github.com/momobasehq/momobase"
---

<footer class="border-t border-border dark:border-border-dark">
  <div class="mx-auto flex min-h-24 w-full max-w-[1128px] items-center justify-between gap-8 px-6 text-xs text-muted max-sm:flex-col max-sm:items-start max-sm:justify-center max-sm:px-4 max-sm:py-6 dark:text-muted-dark">
    <p>Momobase is open source under the MIT license.</p>
    <nav class="flex gap-6" aria-label="Footer navigation">
      <a class="hover:text-text dark:hover:text-text-dark" href={`${repository}/releases`}>Releases</a>
      <a class="hover:text-text dark:hover:text-text-dark" href={`${repository}/blob/main/LICENSE.txt`}>License</a>
    </nav>
  </div>
</footer>
