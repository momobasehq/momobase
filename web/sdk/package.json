{
	"name": "momobase",
	"version": "0.1.0",
	"description": "TypeScript SDK for the Momobase payment service API.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/momobasehq/momobase.git",
		"directory": "web/sdk"
	},
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"release": "release-it",
		"typecheck": "tsc -p tsconfig.json --noEmit"
	},
	"devDependencies": {
		"release-it": "^20.2.1",
		"typescript": "^5.5.0"
	},
	"release-it": {
		"hooks": {
			"before:init": [
				"pnpm run typecheck",
				"pnpm run build"
			]
		},
		"git": {
			"requireBranch": "main",
			"commitMessage": "chore(sdk): release ${version}",
			"tagName": "sdk-v${version}",
			"tagAnnotation": "Momobase SDK v${version}"
		},
		"npm": {
			"publish": true,
			"skipChecks": true
		}
	}
}
