{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"files": {
		"includes": [
			"sdk/src/**",
			"sdk/package.json",
			"sdk/tsconfig.json",
			"dashboard/src/**",
			"dashboard/*.json",
			"dashboard/*.ts",
			"dashboard/index.html"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"indentWidth": 4
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"semicolons": "always"
		}
	}
}
