APP_PORT=9090
APP_NAME=momobase
APP_ENV=staging
CORS_ALLOWED_ORIGINS=https://payments.example.com
APP_PUBLIC_URL=https://payments.example.com
LOG_LEVEL=info
AUTO_MIGRATE=false

DB_USER=momobase
DB_PASSWORD=replace-with-long-postgres-password
DB_NAME=momobase

# Generate with: openssl rand -base64 32
ENCRYPTION_MASTER_KEY_BASE64=replace-with-32-byte-base64-key

# Generate with: openssl rand -hex 32
ADMIN_OAUTH_SECRET=replace-with-at-least-32-char-admin-token-secret
APP_OAUTH_SECRET=replace-with-at-least-32-char-app-token-secret

DASHBOARD_ENABLED=true
