# syntax=docker/dockerfile:1
#
# Runtime image for released binaries. GoReleaser has already built and linked
# the binary statically for the target platform, so there is nothing to compile
# here. Dockerfile builds the image from source instead, and the two runtimes
# are kept identical on purpose: same base, user, paths, and entrypoint.
FROM debian:bookworm-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates tzdata \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY momobase /usr/local/bin/momobase
RUN mkdir -p /app/data && useradd -r -u 10001 -g nogroup momobase && chown -R momobase:nogroup /app
USER momobase
EXPOSE 9090
ENTRYPOINT ["momobase"]
CMD ["serve"]
