APP_NAME=momobase
APP_ENV=development
APP_ADDR=:9090
APP_PUBLIC_URL=http://localhost:9090
CORS_ALLOWED_ORIGINS=http://localhost:9090

# Proxies in front of this deployment, as addresses or CIDRs. Empty means no
# X-Forwarded-For is believed and rate limiting keys on the immediate peer — correct
# when nothing is in front, but behind a proxy it puts every client in one bucket.
# Only set this to proxies you control: the header is one any caller can forge.
TRUSTED_PROXY_CIDRS=
LOG_LEVEL=debug
AUTO_MIGRATE=true

# sqlite | postgres | mysql
DB_TYPE=sqlite
DB_PATH=./data/momobase.db

# DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=momobase
DB_PASSWORD=secret
DB_NAME=momobase
DB_SSLMODE=disable

# DB_TYPE=mysql
DB_PARSE_TIME=true

# Shared Redis cache. REDIS_USERNAME and REDIS_PASSWORD are optional when the
# Redis deployment does not require authentication.
REDIS_ADDR=localhost:6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS_ENABLED=false
CACHE_TTL_SECONDS=300

# Must be base64 for exactly 32 bytes. Generate: openssl rand -base64 32
ENCRYPTION_MASTER_KEY_BASE64=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

ADMIN_OAUTH_SECRET=change-me-admin-oauth-secret-at-least-32-chars
APP_OAUTH_SECRET=change-me-app-oauth-secret-at-least-32-chars
ADMIN_ACCESS_TTL_MINUTES=15
ADMIN_REFRESH_TTL_HOURS=24
APP_ACCESS_TTL_MINUTES=30
APP_CLIENT_ID_PREFIX=app_client
APP_CLIENT_SECRET_PREFIX=mb_test

WORKERS_ENABLED=true
HEALTH_WORKER_ENABLED=true
HEALTH_CHECK_INTERVAL_SECONDS=30
RECONCILIATION_WORKER_ENABLED=true
RECONCILIATION_INTERVAL_SECONDS=60
CLEANUP_WORKER_ENABLED=true
CLEANUP_INTERVAL_SECONDS=300

# Serves the administration dashboard at /dashboard/. Only takes effect in a binary
# built with the dashboard tag (see `make build-dashboard`); a plain `go build` has
# no bundle embedded and serves nothing there.
DASHBOARD_ENABLED=false
